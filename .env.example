# ==============================================================================
# AMBIENTE 1: DESARROLLO (npm run dev)
# ==============================================================================
# NODE_ENV="development"
# NEXT_PUBLIC_API_URL="http://localhost:3000/graphql"
# NEXT_PUBLIC_STORAGE_URL="https://pub-[tu-hash].r2.dev" # URL pública de tu bucket R2


# ==============================================================================
# AMBIENTE 2: PRE-PRODUCCIÓN (docker-compose)
# ==============================================================================
# NODE_ENV="preproduction"
# NEXT_PUBLIC_API_URL="http://localhost:3000/graphql" # O el dominio donde esté tu backend en pre-prod
# NEXT_PUBLIC_STORAGE_URL="http://localhost:9000/msms-bucket" # Apunta al MinIO local


# ==============================================================================
# AMBIENTE 3: PRODUCCIÓN
# ==============================================================================
# NODE_ENV="production"
# NEXT_PUBLIC_API_URL="https://api.tu-dominio.com/graphql"
# NEXT_PUBLIC_STORAGE_URL="https://cdn.tu-dominio.com"
