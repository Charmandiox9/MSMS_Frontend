# ==============================================================================
# AMBIENTE 1: DESARROLLO (npm run dev)
# ==============================================================================
# IMPORTANTE: Copia este archivo como ".env.development.local"
# NODE_ENV="development"
# NEXT_PUBLIC_API_URL="http://localhost:3000/graphql"
# NEXT_PUBLIC_STORAGE_URL="https://pub-[tu-hash].r2.dev" # URL pública de tu R2


# ==============================================================================
# AMBIENTE 2: PRE-PRODUCCIÓN (docker-compose local)
# ==============================================================================
# IMPORTANTE: Copia este archivo como ".env" (sin extensión) o ".env.local"
# NODE_ENV="preproduction"
# NEXT_PUBLIC_API_URL="/graphql" # En docker-compose NGINX rutea esto al backend
# NEXT_PUBLIC_STORAGE_URL="/storage" # NGINX lo rutea a MinIO


# ==============================================================================
# AMBIENTE 3: PRODUCCIÓN
# ==============================================================================
# IMPORTANTE: Copia este archivo como ".env.production"
# NODE_ENV="production"
# NEXT_PUBLIC_API_URL="/graphql" # Asumiendo que el proxy NGINX se usa en prod
# NEXT_PUBLIC_STORAGE_URL="/storage" # MinIO se usará igual en prod
