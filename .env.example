# Local direct backend (npm run dev): http://localhost:3001/api/graphql
# Behind Dokploy/Traefik or the local Nginx stack, use the relative same-origin URL.
NEXT_PUBLIC_API_URL=/api/graphql
# Dockerfile ARG NEXT_PUBLIC_API_URL must be set when building the image.
# Runtime-config exposes only this public URL; never place secrets in NEXT_PUBLIC_*.
# Private evidence is accessed through signed URLs returned by the backend.
